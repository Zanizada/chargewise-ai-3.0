# Copie para .env. A aplicação usa demo por padrão e não chama API.
CHARGEWISE_MODO=demo
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_API_KEY=
TEMPERATURE=0.2
TOP_P=0.9
MAX_TOKENS=512
TIMEOUT_SEGUNDOS=90
MAX_TURNOS=6
# LCEL: orçamento do histórico; não inclui system prompt nem pergunta atual.
MAX_TOKENS_MEMORIA=2048
PROMPT_VERSAO=v2
# Opcional; requer requirements-langchain.txt. Primeira carga pode baixar encoding.
CONTAR_TOKENS=false
