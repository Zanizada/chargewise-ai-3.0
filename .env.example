# Copie para .env. A aplicação usa demo por padrão e não chama API.
CHARGEWISE_MODO=demo
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_API_KEY=
TEMPERATURE=0.2
TOP_P=0.9
MAX_TOKENS=512
TIMEOUT_SEGUNDOS=90
MAX_TURNOS=6
# LCEL: orçamento do histórico; não inclui system prompt nem pergunta atual.
MAX_TOKENS_MEMORIA=2048
PROMPT_VERSAO=v4
# Opcional; requer requirements-langchain.txt. Primeira carga pode baixar encoding.
CONTAR_TOKENS=false

# Sprint 04: geração cloud e embeddings configurados separadamente.
RAG_BASE_URL=https://ollama.com
RAG_MODEL=gpt-oss:120b
# Se vazio, reutiliza OLLAMA_API_KEY. Não publique chaves.
RAG_API_KEY=
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_API_KEY=
RAG_PROMPT=v2
RAG_K=4
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
# Distância de cosseno: valor menor = mais próximo. Calibrar nos evals.
RAG_MAX_DISTANCE=0.55
RAG_TEMPERATURE=0
RAG_TOP_P=0.9
RAG_MAX_TOKENS=2048
RAG_TIMEOUT=90
